# Yerel geliştirme için bu dosyayı .env olarak kopyalayın:
# cp .env.example .env

# PostgreSQL bağlantısı (yerel)
DATABASE_URL=postgresql://postgres:sifreniz@localhost:5432/petmatedb

# JWT gizli anahtarı — uzun ve rastgele bir şey yazın
JWT_SECRET=buraya_cok_uzun_ve_rastgele_bir_sifre_yazin_abc123xyz

# Sunucu portu
PORT=3000

# Ortam (local'de development, Render'da production olarak zaten gelir)
NODE_ENV=development
